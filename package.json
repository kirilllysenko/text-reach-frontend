{
  "name": "texting-frontend-svelte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:graphql": "houdini generate --pull-schema",
    "generate:graphql:check": "houdini generate --pull-schema",
    "generate:live-update": "bun ./scripts/generate-live-update.ts",
    "generate:live-update:check": "bun ./scripts/generate-live-update.ts --check",
    "generate:contracts": "bun run generate:graphql && bun run generate:live-update",
    "validate:live-update": "asyncapi validate ../text-reach-backend/asyncapi/live-update.json",
    "prepare": "bun run generate:graphql && svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@asyncapi/cli": "^6.0.2",
    "@asyncapi/modelina": "^5.10.1",
    "@asyncapi/parser": "^3.6.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/papaparse": "^5.5.2",
    "houdini": "^2.0.7",
    "houdini-svelte": "^3.0.3",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@stripe/stripe-js": "^9.9.0",
    "fast-sort": "^3.4.1",
    "fast-xml-parser": "^5.9.3",
    "fuse.js": "^7.4.2",
    "papaparse": "^5.5.4",
    "remeda": "^2.33.6",
    "svelte-virtuallists": "^1.4.2",
    "text-reach-frontend-library": "file:../text-reach-frontend-library",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  }
}
